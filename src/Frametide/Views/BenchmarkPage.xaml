<UserControl x:Class="Frametide.Views.BenchmarkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Recording" Style="{StaticResource H2}"/>
        <TextBlock Text="When a game from your Game Boost list runs, Frametide records every frame with Intel PresentMon and saves a summary when the game closes: average FPS, 1% and 0.1% lows, stutters, GPU power. PresentMon reads Windows' own graphics events (ETW), the game process is not touched." Style="{StaticResource Sub}"/>
        <CheckBox x:Name="RecordCheck" Content="Record games from the Game Boost list automatically" Margin="0,4"/>
        <CheckBox x:Name="SkipCheck" Content="Next session WITHOUT Game Boost (for a comparison, switches back on by itself afterwards)" Margin="0,4"/>
        <DockPanel Margin="0,10,0,0">
          <Button x:Name="PmDownload" DockPanel.Dock="Right" Content="Download PresentMon" Margin="8,0,0,0" VerticalAlignment="Top"/>
          <TextBlock x:Name="PmText" Foreground="{StaticResource Muted}" FontSize="12"/>
        </DockPanel>
        <TextBlock x:Name="StatusText" Margin="0,10,0,0" FontWeight="SemiBold"/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Padding="18,12">
      <WrapPanel>
        <TextBlock Text="GAME" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ComboBox x:Name="GameFilter" Width="240" Margin="0,0,24,0"/>
        <TextBlock Text="SESSIONS" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ComboBox x:Name="BoostFilter" Width="200" Margin="0,0,24,0"/>
        <TextBlock Text="PERIOD" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ComboBox x:Name="PeriodFilter" Width="160"/>
        <TextBlock x:Name="FilterInfo" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="20,0,0,0"/>
      </WrapPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Without vs. with Game Boost" Style="{StaticResource H2}"/>
        <TextBlock Text="Averages of all sessions per game, weighted by playing time. Only compare like with like (same mode/map). With an FPS limit (in game, V-Sync, G-Sync) the average FPS stays the same, look at the lows and stutters then." Style="{StaticResource Sub}"/>
        <StackPanel x:Name="Compare"/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Sessions" Style="{StaticResource H2}"/>
        <TextBlock Text="1% low = FPS of the slowest 1 % of frames (99th percentile frame time). Stutter = a single frame that takes more than 2.5 times as long as the frames right before it (even, slow phases like loading screens do not count). Hitch = a frame over 100 ms. Sessions shorter than one minute are not saved." Style="{StaticResource Sub}"/>
        <StackPanel x:Name="SessionList"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
