<UserControl x:Class="Frametide.Views.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <WrapPanel>
          <ComboBox x:Name="ProfileCombo" Width="220" Margin="0,0,10,8"/>
          <Button x:Name="ProfileApply" Content="Apply profile" Style="{StaticResource Primary}" Margin="0,0,8,8"/>
          <Button x:Name="Refresh" Content="Re-check" Margin="0,0,8,8"/>
          <Button x:Name="RevertAll" Content="Revert everything" Style="{StaticResource Danger}" Margin="0,0,8,8"/>
        </WrapPanel>
        <TextBlock x:Name="ProfileDesc" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        <TextBlock x:Name="Summary" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel>
          <Button x:Name="RepairAll" DockPanel.Dock="Right" Content="Repair all" Margin="0" VerticalAlignment="Top"/>
          <StackPanel>
            <TextBlock Text="Harmful tweaks from other tools" Style="{StaticResource H2}"/>
            <TextBlock Text="Detects common placebo or harmful tweaks and restores the Windows default." Style="{StaticResource Sub}"/>
          </StackPanel>
        </DockPanel>
        <StackPanel x:Name="RepairList"/>
      </StackPanel>
    </Border>
    <StackPanel x:Name="TweakGroups"/>
  </StackPanel>
</UserControl>
