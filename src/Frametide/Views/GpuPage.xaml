<UserControl x:Class="Frametide.Views.GpuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock x:Name="GpuName" Style="{StaticResource H2}"/>
        <UniformGrid Columns="4" Margin="0,12,0,0">
          <StackPanel Margin="0,0,0,14"><TextBlock Text="GPU CLOCK" Style="{StaticResource Label}"/><TextBlock x:Name="LiveClock" Style="{StaticResource Big}" Text="-"/></StackPanel>
          <StackPanel><TextBlock Text="TEMPERATURE" Style="{StaticResource Label}"/><TextBlock x:Name="LiveTemp" Style="{StaticResource Big}" Text="-"/></StackPanel>
          <StackPanel><TextBlock Text="POWER / LIMIT" Style="{StaticResource Label}"/><TextBlock x:Name="LivePower" Style="{StaticResource Big}" Text="-"/></StackPanel>
          <StackPanel><TextBlock Text="LOAD" Style="{StaticResource Label}"/><TextBlock x:Name="LiveUtil" Style="{StaticResource Big}" Text="-"/></StackPanel>
          <StackPanel><TextBlock Text="MEMORY CLOCK" Style="{StaticResource Label}"/><TextBlock x:Name="LiveMem" Style="{StaticResource Big}" Text="-"/></StackPanel>
          <StackPanel><TextBlock Text="CLOCK OFFSET" Style="{StaticResource Label}"/><TextBlock x:Name="LiveOffset" Style="{StaticResource Big}" Text="-"/></StackPanel>
          <StackPanel><TextBlock Text="VOLTAGE" Style="{StaticResource Label}"/><TextBlock x:Name="LiveVolt" Style="{StaticResource Big}" Text="-"/></StackPanel>
          <StackPanel><TextBlock Text="ACTIVE TUNING" Style="{StaticResource Label}"/><TextBlock x:Name="TuneState" FontSize="15" Margin="0,6,0,0" Text="-"/></StackPanel>
        </UniformGrid>
      </StackPanel>
    </Border>

    <Border x:Name="UvCard" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Smart auto undervolt" Style="{StaticResource H2}"/>
        <TextBlock Style="{StaticResource Sub}" Text="Fully automatic with the built-in GPU stress test, no extra program needed. STOCK: power limit temporarily at max, measures your real boost clock and voltage. PROBE: keeps that clock and lowers the voltage step by step until the GPU makes computation errors or the driver resets. REPLAY: validates the best step with a longer run, only then a profile is saved. Takes about 5-8 minutes. A short black screen during a driver reset is normal and harmless. Close MSI Afterburner and other tuning tools first."/>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border x:Name="PhaseStock" Background="{StaticResource Panel2}" CornerRadius="8" Padding="12,8"><StackPanel>
            <TextBlock Text="STOCK" Style="{StaticResource Label}"/><TextBlock Text="Measure clock + voltage" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
          <Border x:Name="PhaseProbe" Grid.Column="2" Background="{StaticResource Panel2}" CornerRadius="8" Padding="12,8"><StackPanel>
            <TextBlock Text="PROBE" Style="{StaticResource Label}"/><TextBlock Text="Lower the voltage step by step" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
          <Border x:Name="PhaseReplay" Grid.Column="4" Background="{StaticResource Panel2}" CornerRadius="8" Padding="12,8"><StackPanel>
            <TextBlock Text="REPLAY" Style="{StaticResource Label}"/><TextBlock Text="Validate the best step" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
        </Grid>
        <WrapPanel>
          <StackPanel Margin="0,0,16,10"><TextBlock Text="TARGET CLOCK (0 = AUTO)" Style="{StaticResource Label}" Margin="0,0,0,4"/><TextBox x:Name="UvTarget" Width="120" Text="0"/></StackPanel>
          <StackPanel Margin="0,0,16,10"><TextBlock Text="STEP (MHz)" Style="{StaticResource Label}" Margin="0,0,0,4"/><TextBox x:Name="UvStep" Width="90" Text="30"/></StackPanel>
          <StackPanel Margin="0,0,16,10"><TextBlock Text="ROUND (s)" Style="{StaticResource Label}" Margin="0,0,0,4"/><TextBox x:Name="UvRound" Width="90" Text="40"/></StackPanel>
          <StackPanel Margin="0,0,16,10"><TextBlock Text="MAX OFFSET" Style="{StaticResource Label}" Margin="0,0,0,4"/><TextBox x:Name="UvMax" Width="90" Text="300"/></StackPanel>
          <StackPanel Margin="0,0,16,10"><TextBlock Text="TEMP LIMIT (°C)" Style="{StaticResource Label}" Margin="0,0,0,4"/><TextBox x:Name="UvTemp" Width="90" Text="83"/></StackPanel>
        </WrapPanel>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="UvStart" Content="Start smart undervolt" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
          <Button x:Name="UvCancel" Content="Cancel" Style="{StaticResource Danger}" Margin="0" IsEnabled="False"/>
        </StackPanel>
        <TextBlock x:Name="UvWarning" Visibility="Collapsed" Margin="0,10,0,0" Foreground="{StaticResource Warn}"/>
        <TextBlock x:Name="UvStatus" Visibility="Collapsed" Margin="0,8,0,0" FontWeight="SemiBold"/>
        <UniformGrid x:Name="UvLiveGrid" Columns="5" Margin="0,10,0,0" Visibility="Collapsed">
          <StackPanel><TextBlock Text="CLOCK" Style="{StaticResource Label}"/><TextBlock x:Name="UvLClock" FontSize="20" FontWeight="SemiBold" Text="-"/></StackPanel>
          <StackPanel><TextBlock Text="VOLTAGE" Style="{StaticResource Label}"/><TextBlock x:Name="UvLVolt" FontSize="20" FontWeight="SemiBold" Text="-"/></StackPanel>
          <StackPanel><TextBlock Text="POWER" Style="{StaticResource Label}"/><TextBlock x:Name="UvLPower" FontSize="20" FontWeight="SemiBold" Text="-"/></StackPanel>
          <StackPanel><TextBlock Text="TEMPERATURE" Style="{StaticResource Label}"/><TextBlock x:Name="UvLTemp" FontSize="20" FontWeight="SemiBold" Text="-"/></StackPanel>
          <StackPanel><TextBlock Text="ERRORS" Style="{StaticResource Label}"/><TextBlock x:Name="UvLErr" FontSize="20" FontWeight="SemiBold" Text="-"/></StackPanel>
        </UniformGrid>
        <TextBlock x:Name="UvLive" Visibility="Collapsed" Margin="0,6,0,0" Foreground="{StaticResource Muted}" FontFamily="Consolas"/>
        <StackPanel x:Name="UvRounds" Margin="0,8,0,0"/>
        <Border x:Name="UvResult" Background="{StaticResource Panel2}" CornerRadius="10" Padding="18" Margin="0,12,0,0" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="Smart undervolt results" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
            <UniformGrid Columns="2" Margin="0,12,0,14">
              <StackPanel HorizontalAlignment="Center"><TextBlock Text="STOCK" Foreground="{StaticResource Warn}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="RStockW" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="WATTS" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel>
              <StackPanel HorizontalAlignment="Center"><TextBlock Text="UNDERVOLT" Foreground="{StaticResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="RUvW" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="WATTS" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel>
            </UniformGrid>
            <UniformGrid Columns="4" Margin="0,0,0,10">
              <StackPanel HorizontalAlignment="Center"><TextBlock x:Name="RStockV" FontSize="22" Foreground="{StaticResource Warn}" HorizontalAlignment="Center"/><TextBlock Text="Stock voltage (V)" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
              <StackPanel HorizontalAlignment="Center"><TextBlock x:Name="RUvV" FontSize="22" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="Undervolt voltage (V)" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
              <StackPanel HorizontalAlignment="Center"><TextBlock x:Name="RStockC" FontSize="22" Foreground="{StaticResource Warn}" HorizontalAlignment="Center"/><TextBlock Text="Stock clock (MHz)" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
              <StackPanel HorizontalAlignment="Center"><TextBlock x:Name="RUvC" FontSize="22" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="Undervolt clock (MHz)" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
            </UniformGrid>
            <UniformGrid Columns="3">
              <StackPanel HorizontalAlignment="Center"><TextBlock Text="POWER SAVED" Style="{StaticResource Label}" HorizontalAlignment="Center"/><TextBlock x:Name="RSaved" FontSize="22" Foreground="{StaticResource Good}" HorizontalAlignment="Center"/></StackPanel>
              <StackPanel HorizontalAlignment="Center"><TextBlock Text="VOLTAGE DROP" Style="{StaticResource Label}" HorizontalAlignment="Center"/><TextBlock x:Name="RDrop" FontSize="22" Foreground="{StaticResource Good}" HorizontalAlignment="Center"/></StackPanel>
              <StackPanel HorizontalAlignment="Center"><TextBlock Text="MAX TEMP" Style="{StaticResource Label}" HorizontalAlignment="Center"/><TextBlock x:Name="RTemp" FontSize="22" HorizontalAlignment="Center"/></StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border x:Name="ManualCard" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Manual" Style="{StaticResource H2}"/>
        <TextBlock Text="Max clock 0 = no clock lock. Positive offset with clock lock = undervolt. Positive offset without lock = overclock." Style="{StaticResource Sub}"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Text="Max clock (MHz)" VerticalAlignment="Center"/>
          <TextBox x:Name="ManMax" Grid.Column="1" Width="110" HorizontalAlignment="Left" Text="0" Margin="0,4"/>
          <TextBlock Grid.Row="1" Text="Clock offset" VerticalAlignment="Center"/>
          <Slider x:Name="ManOffset" Grid.Row="1" Grid.Column="1" Minimum="-300" Maximum="300" TickFrequency="15" IsSnapToTickEnabled="True" Value="0" Margin="0,10"/>
          <TextBlock x:Name="ManOffsetText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          <TextBlock Grid.Row="2" Text="Power limit" VerticalAlignment="Center"/>
          <Slider x:Name="ManPower" Grid.Row="2" Grid.Column="1" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,10"/>
          <TextBlock x:Name="ManPowerText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
        <WrapPanel Margin="0,10,0,0">
          <Button x:Name="ManApply" Content="Apply" Style="{StaticResource Primary}" Margin="0,0,8,8"/>
          <Button x:Name="ManReset" Content="GPU to default" Margin="0,0,8,8"/>
          <TextBox x:Name="ManName" Width="200" Margin="0,0,8,8" Text="My profile"/>
          <Button x:Name="ManSave" Content="Save as profile" Margin="0,0,8,8"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border x:Name="ProfilesCard" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Saved profiles" Style="{StaticResource H2}"/>
        <TextBlock Text="A profile can be applied on START (Game Boost) or permanently at Windows sign-in. Otherwise the GPU runs at defaults again after a reboot." Style="{StaticResource Sub}"/>
        <StackPanel x:Name="ProfileList"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="STRESS TEST DURATION (s)" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBox x:Name="TestSec" Width="80" Text="300"/>
          <Button x:Name="TestCancel" Content="Stop test" Style="{StaticResource Danger}" Margin="10,0,0,0" IsEnabled="False"/>
        </StackPanel>
        <TextBlock x:Name="TestStatus" Visibility="Collapsed" Margin="0,10,0,0" FontWeight="SemiBold"/>
        <TextBlock x:Name="TestLive" Visibility="Collapsed" Margin="0,4,0,0" Foreground="{StaticResource Muted}" FontFamily="Consolas"/>
      </StackPanel>
    </Border>

    <Border x:Name="NvCard" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="NVIDIA game profiles" Style="{StaticResource H2}"/>
        <TextBlock Text="Sets 'Power management: prefer maximum performance' and 'Low latency mode: On' in the driver profile of every game in your Game Boost list, and the shader cache to unlimited. Games with NVIDIA Reflex use Reflex instead of the low latency mode. ShadowPlay, the overlay and the NVIDIA App are not touched. Undo restores the previous values." Style="{StaticResource Sub}"/>
        <CheckBox x:Name="NvGlobalCheck" IsChecked="True" Margin="0,0,0,10" Content="Set the GLOBAL power management back to 'Normal' (lower power on the desktop; your games keep maximum performance through their own profile)"/>
        <StackPanel x:Name="NvList" Margin="0,0,0,10"/>
        <WrapPanel>
          <Button x:Name="NvOptimize" Content="Optimize game profiles" Style="{StaticResource Primary}" Margin="0,0,8,8"/>
          <Button x:Name="NvUndo" Content="Undo" Margin="0,0,8,8"/>
          <Button x:Name="NvReload" Content="Reload" Margin="0,0,8,8"/>
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
