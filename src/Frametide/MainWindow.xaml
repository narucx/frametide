<Window x:Class="Frametide.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frametide" Icon="Assets/frametide.ico" Width="1280" Height="820" MinWidth="1050" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Background="{StaticResource Bg}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Navigation -->
    <Border Background="#0A0C0F" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="24,26,20,26">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="FRAME" FontSize="22" FontWeight="Black" FontFamily="Segoe UI Variable Display, Segoe UI"/>
            <TextBlock Text="TIDE" FontSize="22" FontWeight="Black" Foreground="{StaticResource Accent}" FontFamily="Segoe UI Variable Display, Segoe UI"/>
          </StackPanel>
          <Border x:Name="PrereleaseBadge" Background="{StaticResource WarnSoft}" CornerRadius="5" Padding="7,2" Margin="0,6,0,0" HorizontalAlignment="Left">
            <TextBlock Text="PREVIEW" Foreground="{StaticResource Warn}" FontSize="10" FontWeight="Bold"/>
          </Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="24,0,20,20">
          <TextBlock Text="LANGUAGE" Style="{StaticResource Label}" Margin="0,0,0,6"/>
          <ComboBox x:Name="LangCombo" Margin="0,0,0,12"/>
          <Button x:Name="UpdateButton" Style="{StaticResource Primary}" Margin="0,0,0,12" Visibility="Collapsed"/>
          <TextBlock x:Name="FooterText" FontSize="10" Foreground="{StaticResource Muted}"/>
        </StackPanel>
        <StackPanel x:Name="NavPanel"/>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Margin="32,26,32,16">
        <TextBlock x:Name="PageTitle" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
        <TextBlock x:Name="PageSub" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
      </StackPanel>
      <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,10">
        <ContentControl x:Name="PageHost"/>
      </ScrollViewer>
      <Border Grid.Row="2" Background="#0A0C0F" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="32,8">
        <DockPanel>
          <TextBlock x:Name="BusyText" DockPanel.Dock="Right" Foreground="{StaticResource Accent}"/>
          <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
