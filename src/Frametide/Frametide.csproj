<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification area icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003 wants the DPI mode set through WinForms; this is a WPF app, which takes it from app.manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\frametide.ico</ApplicationIcon>
    <RootNamespace>Frametide</RootNamespace>
    <AssemblyName>Frametide</AssemblyName>
    <!-- Own Main (Program.cs) so Velopack's hooks run before WPF starts. -->
    <StartupObject>Frametide.Program</StartupObject>
    <!-- Runs elevated: no DOTNET_STARTUP_HOOKS (a variable any user process can set loads code into the app). -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms and WPF share many type names; WinForms types are always written fully qualified. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Frametide.Core\Frametide.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Translations: English text -> translated text. -->
    <EmbeddedResource Include="Lang\*.json" />
    <Resource Include="Assets\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
