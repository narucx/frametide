<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that changes the system (tweaks, journal, GPU, game boost) lives here, without UI. -->
  <PropertyGroup>
    <!-- Windows 10 2004 or newer; the version also brings the WinRT APIs (PackageManager for Store apps). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Frametide.Core</RootNamespace>
    <!-- Required by the [LibraryImport] source generator (P/Invoke marshalling code). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Frametide.Tests" />
  </ItemGroup>

</Project>
