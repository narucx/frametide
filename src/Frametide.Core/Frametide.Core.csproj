<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that changes the system (tweaks, journal, GPU, game boost) lives here, without UI. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Frametide.Core</RootNamespace>
    <!-- Required by the [LibraryImport] source generator (P/Invoke marshalling code). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Frametide.Tests" />
  </ItemGroup>

</Project>
