<Project>
  <!-- Shared settings for all projects. The version is the single source of truth for builds and releases. -->
  <PropertyGroup>
    <Version>0.1.0-beta.5</Version>
    <Product>Frametide</Product>
    <Authors>Henri</Authors>
    <Copyright>Copyright (C) 2026 Henri. Licensed under the GNU GPL v3.</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
